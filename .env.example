APP_NAME="Gorkhali Khabar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

MYSQL_DATABASE=gorkhali
MYSQL_USER=gorkhali
MYSQL_PASSWORD=gorkhali_dev
MYSQL_ROOT_PASSWORD=gorkhali_root_dev

REDIS_HOST=redis
REDIS_PORT=6379
SESSION_DRIVER=redis
SESSION_COOKIE=gorkhali_session
CACHE_STORE=redis
CACHE_PREFIX=gorkhali-khabar-cache-
REDIS_PREFIX=gorkhali-khabar-database-
QUEUE_CONNECTION=redis

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=news@example.test
MAIL_FROM_NAME="Gorkhali Khabar"

# Use local storage for development. Set cloudinary in production only when all
# Cloudinary values below are supplied outside source control.
MEDIA_STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gorkhali-khabar

SANCTUM_STATEFUL_DOMAINS=localhost:8080

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
NEXT_PUBLIC_SITE_URL=http://localhost:8080
# Leave blank for same-origin browser requests through nginx/cPanel.
NEXT_PUBLIC_LARAVEL_API_URL=
# Server-only URL used by Next.js server rendering.
API_INTERNAL_URL=http://web
